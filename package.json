{
  "name": "dsh-claude-fonts",
  "version": "1.1.0",
  "description": "Claude (Anthropic) typefaces for the DeepSeek Harness web GUI: Anthropic Sans for the interface, Anthropic Serif for conversation prose, Anthropic Mono for code. Fonts are bundled.",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "fonts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "font",
    "anthropic",
    "claude"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1 <0.3.0",
      "profiles": [
        "web",
        "desktop"
      ]
    }
  }
}
